#!/usr/bin/env sh

## ERROR LOGS :: tail -f /tmp/yabai_$USER.err.log

# ------------------
# SCRIPTING ADDITION
# ------------------
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa
 
# ------
# PARAMS
# ------
yabai -m config \
         layout stack \
         mouse_follows_focus on \
         focus_follows_mouse off \
         window_origin_display cursor \
         window_placement second_child \
         window_zoom_persist off \
         window_insertion_point last \
         window_shadow off \
         window_opacity off \
         insert_feedback_color 0xffd75f5f \
         split_ratio 0.55 \
         split_type auto \
         auto_balance off \
         window_gap 2 \
         top_padding 0 \
         left_padding 0 \
         right_padding 0 \
         bottom_padding 0 \
         mouse_modifier ctrl \ 
         mouse_action1 move \
         mouse_action2 resize \
         mouse_drop_action swap

# ----------------- 
# ADDITIONAL PARAMS
# ----------------- 
yabai -m space 1 --layout float
yabai -m config --display 1 external_bar all:33:0

# -----
# RULES
# -----
yabai -m rule --add app="Picture in Picture" sticky=on

yabai -m rule --add title="XQuartz" manage=on role="AXWindow" subrole="AXDialog" manage=on

yabai -m rule --add app='XQuartz' manage=on role="AXWindow" subrole="AXDialog" manage=on

yabai -m rule --add app='^XQuartz$' manage=on role="AXWindow" subrole="AXDialog" manage=on

yabai -m rule --add app='^X11.bin$' manage=on role="AXWindow" subrole="AXDialog" manage=on

yabai -m rule --add app='X11.bin' manage=on role="AXWindow" subrole="AXDialog" manage=on

yabai -m rule --add app='X11' manage=off role="AXWindow" subrole="AXDialog" manage=on


yabai -m rule --add title="^f:.+" manage=off
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app='^Calculator$' manage=off
yabai -m rule --add app="^App Eraser$" manage=off
yabai -m rule --add app="^LuLu$" manage=off

yabai -m rule --add app="^Digital Colou?r Meter$" sticky=on
yabai -m rule --add app="^qutebrowser$" title!="^$" role="AXWindow" subrole="AXDialog" manage=on

yabai -m rule --apply

# -------
# SIGNALS
# -------
yabai -m signal --add event=window_focused action="sketchybar --trigger yabai_window_focused"
yabai -m signal --add event=window_destroyed action="yabai -m window --focus mouse"
yabai -m signal --add event=application_terminated action="yabai -m window --focus mouse"

echo "yabai configuration loaded."
