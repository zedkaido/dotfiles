#vim:filetype=bash

:: default : sketchybar -m --set modal label="[N]" label.color=0xFF888888
:: yabai @ : sketchybar -m --set modal label="[YABAI]" label.color=0xFF14DFC4
:: app @ : sketchybar -m --set modal label="[APP]" label.color=0xFFFFD700
:: action @ : sketchybar -m --set modal label="[ACT]" label.color=0xFFFFFFFF
:: position @ : sketchybar -m --set modal label="[POSITION]" label.color=0xFFFFFFFF
:: clipboard @ : sketchybar -m --set modal label="[CLIPBOARD]" label.color=0xFFFFFFFF
:: system @ : sketchybar -m --set modal label="[SYSTEM]" label.color=0xFFFF0000

#-------------
# MODE: SYSTEM
#-------------
alt - s ; system
system < escape ; default
system < s : skhd -k "escape" ; pmset sleepnow &

#------------
# MODE: YABAI
#------------
alt - y ; yabai
yabai < escape ; default
yabai < alt - y ; default

yabai < b : yabai -m space --layout bsp && sketchybar --trigger yabai_layout_changed ; skhd -k "escape"
yabai < s : yabai -m space --layout stack && sketchybar --trigger yabai_layout_changed ; skhd -k "escape"
yabai < shift - s : yabai -m window --stack ; skhd -k "escape"
yabai < f : yabai -m space --layout float && sketchybar --trigger yabai_layout_changed ; skhd -k "escape"

yabai < r : yabai --restart-service ; skhd -k "escape"
yabai < n : yabai -m space --create ; skhd -k "escape"
yabai < d : yabai -m space --destroy ; skhd -k "escape"
yabai < shift - n : yabai -m space --create && \
                    index="$(yabai -m query --spaces --display | jq 'map(select(."is-native-fullscreen" == false))[-1].index')" && \
                    yabai -m window --space "${index}" && \
                    yabai -m space --focus "${index}" ; skhd -k "escape"

yabai < p : yabai -m window --toggle sticky --toggle pip # `i` for inny ; skhd -k "escape"
yabai < s : yabai -m window --toggle sticky ; skhd -k "escape" # a for ALL SPACES
yabai < u : yabai -m window --toggle float; yabai -m window --grid 4:4:1:1:2:2 ; skhd -k "escape"
alt - f : yabai -m window --toggle float; yabai -m window --grid 4:4:1:1:2:2 ; skhd -k "escape"

#-------------
# MODE: ACTION
#-------------
alt - a ; action
action < escape ; default
action < alt - a ; default

action < s : open /System/Applications/Utilities/Screenshot.app ; skhd -k "escape"
action < c : skhd -k "escape" ; xq ; colorscheme ; yabai -m window --focus recent

action < d : skhd -k "escape" ; dictionary
action < w : skhd -k "escape" ; webcam
action < p : skhd -k "escape" ; pass-copy
action < b : skhd -k "escape" ; bookmarks
action < t : skhd -k "escape" ; snippet-copy
action < r : skhd -k "escape" ; radio

# --------------
# MODE: POSITION
# --------------
alt - z ; position
position < escape ; default
position < alt - z ; default

# <r>:<c>:<x>:<y>:<w>:<h>
position < f : yabai -m window --grid 1:1:1:0:1:1 ; skhd -k "escape"
position < shift - f : yabai -m window --toggle windowed-fullscreen ; skhd -k "escape"
position < m : yabai -m window --grid 20:20:5:0:10:20 ; skhd -k "escape"
position < c : yabai -m window --grid 4:4:1:1:2:2 ; skhd -k "escape"
position < t : yabai -m window --grid 8:1:0:0:1:2 ; skhd -k "escape"
position < b : yabai -m window --grid 8:1:0:6:1:2 ; skhd -k "escape"

position < p : yabai -m window --grid 20:20:14:0:6:6 ; skhd -k "escape"
position < shift - left : yabai -m window --grid 20:20:0:0:5:5 ; skhd -k "escape"
position < shift - right : yabai -m window --grid 20:20:15:0:5:5 ; skhd -k "escape"
position < left : yabai -m window --grid 20:20:0:15:5:5 ; skhd -k "escape"
position < right : yabai -m window --grid 20:20:15:15:5:5 ; skhd -k "escape"

position < h : yabai -m window --grid 1:2:0:0:1:1 ; skhd -k "escape"
position < j : yabai -m window --grid 2:1:0:2:1:1 ; skhd -k "escape"
position < k : yabai -m window --grid 2:1:0:0:1:1 ; skhd -k "escape"
position < l : yabai -m window --grid 1:2:1:0:1:1 ; skhd -k "escape"

# ---------
# CLIPBOARD
# ---------
alt - c ; clipboard
clipboard < escape ; default

clipboard < c : skhd -k "escape" ; term-window ch
clipboard < alt - c : skhd -k "escape" ; term-window ch copy

clipboard < s : skhd -k "escape" ; ch save
clipboard < alt - s : skhd -k "escape" ; ch save
clipboard < d : skhd -k "escape" ; term-window ch delete
clipboard < e : skhd -k "escape" ; term-window ch edit
clipboard < l : skhd -k "escape" ; term-window ch clear
clipboard < alt - c : skhd -k "escape" ; term-window ch clear
clipboard < 0 : skhd -k "escape" ; ch clear clipboard

#----------
# MODE: APP
#----------
alt - o ; app
app < escape ; default

app < o : skhd -k "escape" ; app-open
app < alt - o : skhd -k "escape"; app-open
app < 0 : skhd -k "escape"; app-open 0
app < 1 : skhd -k "escape"; app-open 1
app < 2 : skhd -k "escape"; app-open 2

app < x : skhd -k "escape" ; xq

app < s : skhd -k "escape" ; exec st

app < f : skhd -k "escape" ; open -a Finder ; skhd -k "escape"
app < shift - h : skhd -k "escape" ; open -a Finder ~/ ; skhd -k "escape"
app < shift - a : skhd -k "escape" ; open -a Finder /Applications ; skhd -k "escape"
app < shift - s : open -a Finder ~/ScreenCapture/ ; skhd -k "escape"
app < shift - p : open -a Finder /Library/Audio/Plug-Ins/ ; skhd -k "escape"

app < c : open -n /Applications/Chromium.app ; skhd -k "escape"
app < q : open -n /Applications/qutebrowser.app ; skhd -k "escape"
app < l : open -n /Applications/LibreWolf.app ; skhd -k "escape"

app < g : open -n /Applications/Ghostty.app ; skhd -k "escape"
app < a : open -n /Applications/Alacritty.app ; skhd -k "escape"
app < e : open -n /Applications/Emacs.app ; skhd -k "escape"

app < b : open -n /Applications/Bitwig\ Studio.app ; skhd -k "escape"

app < t : term-window exe tmux new-session ; skhd -k "escape"

# FZY OPEN APP WINDOWS
alt - g : xq ; yabai-fzy-window dmenu
alt + shift - g: term-window yabai-fzy-window

# default < meh - m [
#   "firefox" : skhd -k 'ctrl + shift - m'
# ]

# -----------------
# YABAI KEYBINDINGS
# -----------------
alt - v : yabai -m window --toggle expose
cmd - m : yabai -m window --minimize
cmd + shift - m : yabai -m window --diminimize

alt - z : yabai -m space --balance
alt - e : yabai -m window --toggle split

alt - n : yabai -m window --focus next
alt - p : yabai -m window --focus prev
alt + shift - n : yabai -m space --focus next
alt + shift - p : yabai -m space --focus prev

alt + cmd - j : yabai -m window --focus stack.next
alt + cmd - k : yabai -m window --focus stack.prev

cmd + alt - u : yabai -m window --swap stack.prev --focus
cmd + alt - m : yabai -m window --swap stack.next --focus

cmd + alt - h : skhd -k cmd - \`
cmd + alt - l : yabai -m window --focus largest

cmd + alt - y : yabai -m window --raise
cmd + alt - n : yabai -m window --lower

ctrl + alt - 0 : yabai -m window --focus stack.0
ctrl + alt - 1 : yabai -m window --focus stack.1
ctrl + alt - 2 : yabai -m window --focus stack.2
ctrl + alt - 3 : yabai -m window --focus stack.3
ctrl + alt - 4 : yabai -m window --focus stack.4
ctrl + alt - 5 : yabai -m window --focus stack.5
ctrl + alt - 6 : yabai -m window --focus stack.6
ctrl + alt - 7 : yabai -m window --focus stack.7
ctrl + alt - 8 : yabai -m window --focus stack.8
ctrl + alt - 9 : yabai -m window --focus stack.9
 
alt - 0 : yabai -m space --focus 1 & sketchybar --set "focus" label="dwm"
alt - 1 : yabai -m space --focus 2
alt - 2 : yabai -m space --focus 3
alt - 3 : yabai -m space --focus 4
alt - 4 : yabai -m space --focus 5
alt - 5 : yabai -m space --focus 6
alt - 6 : yabai -m space --focus 7
alt - 7 : yabai -m space --focus 8
alt - 8 : yabai -m space --focus 9

alt + cmd - 0 : yabai -m window --space 1 --focus
alt + cmd - 1 : yabai -m window --space 2 --focus
alt + cmd - 2 : yabai -m window --space 3 --focus
alt + cmd - 3 : yabai -m window --space 4 --focus
alt + cmd - 4 : yabai -m window --space 5 --focus
alt + cmd - 5 : yabai -m window --space 6 --focus
alt + cmd - 6 : yabai -m window --space 7 --focus
alt + cmd - 7 : yabai -m window --space 8 --focus
alt + cmd - 8 : yabai -m window --space 9 --focus

alt - r : yabai -m window --focus recent
alt + shift - r : yabai -m space --focus recent

alt - h : yabai -m window --focus west || $(yabai -m window --focus west; yabai -m display --focus west)
alt - j : yabai -m window --focus south || $(yabai -m window --focus south; yabai -m display --focus south)
alt - k : yabai -m window --focus north || $(yabai -m window --focus north; yabai -m display --focus north)
alt - l : yabai -m window --focus east || $(yabai -m window --focus east; yabai -m display --focus east)

ctrl + alt - h : yabai -m window --swap west  || $(yabai -m window --display west --focus)
ctrl + alt - j : yabai -m window --swap south || $(yabai -m window --display south --focus)
ctrl + alt - k : yabai -m window --swap north || $(yabai -m window --display north --focus)
ctrl + alt - l : yabai -m window --swap east  || $(yabai -m window --display east --focus)

cmd + alt + ctrl - z : yabai -m window --toggle zoom-fullscreen
cmd + alt + shift - z : yabai -m window --toggle zoom-parent

cmd + alt - m : yabai -m space --mirror y-axis
cmd + alt + shift - m : yabai -m space --mirror x-axis
cmd + alt - r : yabai -m space --rotate 90

shift + ctrl + alt - left : yabai -m window --resize right:-50:0 || yabai -m window --resize left:-50:0 || yabai -m window --resize left:50:0 || yabai -m window --resize right:50:0
shift + ctrl + alt - right : yabai -m window --resize right:50:0 || yabai -m window --resize left:50:0 || yabai -m window --resize left:-50:0 || yabai -m window --resize right:-50:0
shift + ctrl + alt - up :  yabai -m window --resize bottom:0:-50 || yabai -m window --resize top:0:-50 ||  yabai -m window --resize top:0:50 || yabai -m window --resize bottom:0:50
shift + ctrl + alt - down : yabai -m window --resize bottom:0:50 || yabai -m window --resize top:0:50 || yabai -m window --resize top:0:-50 || yabai -m window --resize bottom:0:-50

ctrl + alt - left : yabai -m window --move rel:-40:0
ctrl + alt - right : yabai -m window --move rel:40:0
ctrl + alt - up : yabai -m window --move rel:0:-40
ctrl + alt - down : yabai -m window --move rel:0:40

# ---------
# BLACKLIST
# ---------
# .blacklist [
# 	"Bitwig Studio"
# ]

# alt - a [
#	* : yabai -m space --balance
#	"Bitwig Studio" ~
# ]

# ----------------------
# Nullifying keybindings
# ----------------------
cmd + alt + shift - q : ""

cmd + shift - c [
    "Finder" : ""
]

# -----------------
# OTHER KEYBINDINGS
# -----------------
cmd + alt + ctrl - space : term-window cmd

ctrl + alt + cmd - o : www
ctrl + alt + cmd - e : term-window bweb

ctrl + alt + cmd - d : toggle-dark-theme

ctrl + alt + cmd - t : screencapture -ip

# ----------------
# USED KEYBINDINGS
# ----------------
# [UESD] alt - d :: (DASH)
# [USED] alt - x :: (emacs)
# [USED] cmd + alt + ctrl - i :: opens soundsource panel
