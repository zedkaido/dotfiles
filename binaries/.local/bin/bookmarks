#!/usr/bin/env bash

OS=$(uname -s)
BOOKMARKS_FILE="$HOME/.qutebrowser/bookmarks/urls"

bookmark_open() {
	case "$OS" in
		Linux) cat $BOOKMARKS_FILE | dmenu -l 20 | cut -d ' ' -f1 | xargs xdg-open ;;
		Darwin) cat $BOOKMARKS_FILE | dmenu -l 20 | cut -d ' ' -f1 | xargs open ;;
		*) echo "Unsupported OS. Are you running on a potato?" ;;
	esac
}

bookmark_copy() {
	case "$OS" in
		Linux) cat $BOOKMARKS_FILE | dmenu -l 10 | cut -d ' ' -f1 | xclip -selection clipboard ;;
		Darwin) cat $BOOKMARKS_FILE | dmenu -l 10 | cut -d ' ' -f1 | pbcopy ;;
		*) echo "Unsupported OS. Are you running on a potato?" ;;
	esac
}

bookmark_add() {
	if ! [ -z $1 ]; then
		print $1 >> $BOOKMARKS_FILE
	else
		read link
		print $link >> $BOOKMARKS_FILE
	fi
}

bookmarks_edit() {
	$EDITOR $BOOKMARKS_FILE
}

opts() {
	case "$1" in
		open) bookmark_open ;;
		copy) bookmark_copy ;;
		add) bookmark_add $2 ;;
		edit) term-window exe "$EDITOR $BOOKMARK_FILE" ;;
		*) exit 1 ;;
	esac
}

if [[ -n "$1" ]]; then
	opts "$@"
else
	choice=$(printf "open\\ncopy\\nadd\\nedit" | dmenu)
	opts "$choice"
fi
