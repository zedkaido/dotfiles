#!/usr/bin/env bash

yabai_query=$(yabai -m query --windows | jq -r '.[] | "\(.id):\(.app):\(.title)"')

truncate_string() {
   local s="$1"
   local maxlen="$2"
   if [ ${#s} -gt "$maxlen" ]; then
      echo "${s:0:$maxlen}..."
   else
      echo "$s"
   fi
}

ids=""
app_options=""
index=0

while IFS=':' read -r id app title; do
   truncated_title=$(truncate_string "$title" 100)
   option="[$id] $app: $truncated_title"

   ids="$ids$index:$id\n"
   app_options="$app_options$option\n"
   index=$((index + 1))
done <<EOF
$yabai_query
EOF

echo "$app_options" | sed '$ s/\\n$//'
app_options=$(echo  "$app_options" | sed '$ s/\\n$//')

if [ "$1" = "dmenu" ]; then
   selected_app=$(echo -e "$app_options" | dmenu -i -p "FOCUS APP" -l 12)
else
   selected_app=$(echo -e "$app_options" | fzy)
fi

app_id="${selected_app#\[}"
app_id="${app_id%%]*}"

if [ -n "$app_id" ]; then
   echo "$app_id"
   yabai -m window --focus "$app_id"
   exit 0
else
   echo "No matching window found" >&2
   exit 1
fi
else
   echo "No selection made" >&2
   exit 1
fi
