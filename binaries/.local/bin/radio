#!/usr/bin/env bash

command -v dmenu >/dev/null 2>&1 || { echo "ERROR: dmenu bin is required." >&2 ; exit 1 ; }
command -v term-window >/dev/null 2>&1 || { echo "ERROR: term-window bin is required." >&2 ; }

RADIO_STATIONS="$HOME/.local/share/radio-stations"

radio_listen() {
	station=$(cat $RADIO_STATIONS | dmenu -l 10)
	station_name=$(echo "$station" | awk -F " :: " '{print $1}')
	station_url=$(echo "$station" | awk -F " :: " '{print $2}')

	if [ -z "$station" ] ; then
		exit 0
	fi

	tmux_running=$(pgrep tmux)

	if [ -z "$TMUX" ] && [ -z "$tmux_running" ]; then
		tmux new-session -s "$station_name" "mpv '$station_url'"
	fi

	if ! tmux has-session -ds "$station_name" 2> /dev/null; then
		tmux new-session -ds "$station_name" "mpv '$station_url'"
	fi
}

opts() {
	case $1 in
		listen) radio_listen ;;
		edit) term-window exe "vim $RADIO_STATIONS" ;;
		*) radio_choose ;;
	esac
}

if [[ -n "$1" ]]; then
	opts "$@"
else
	option=$(printf "listen\\nedit" | dmenu)
	opts "$option"
fi
