#!/usr/bin/env bash

command -v dmenu >/dev/null 2>&1 || { echo "ERROR: dmenu bin is required." >&2 ; exit 1 ; }
command -v pass >/dev/null 2>&1 || { echo "pass required" ; exit 1 ; }
command -v term-window >/dev/null 2>&1 || { echo "ERROR: term-window bin is required." >&2 ; }

passfiles() { find . -type f -name '*.gpg' | sed 's/\.gpg//' | sed 's/^\.\///' | sort ; }
usernamefiles() { find . -type f -name '*username.gpg' | sed 's/\.gpg//' | sed 's/^\.\///' | sort ; }
otpfiles() { find . -type f -name '*otp.gpg' | sed 's/\.gpg//' | sed 's/^\.\///' | sort ; }
urlfiles() { find . -type f -name '*url.gpg' | sed 's/\.gpg//' | sed 's/^\.\///' | sort ; }

# MAIN
cd "$HOME/.password-store" || {
	echo "Failed to change directoy to ~/.password-store." >&2 ; exit 1;
}

opts() {
	case "$1" in
		pass)
			spass=$(passfiles | dmenu -p "PASS" -l 5)
			[[ -z $spass ]] && { echo "No pass selected." ; exit 0 ; }
			pass show -c "$spass"
			;;
		username)
			susername=$(usernamefiles | dmenu -p "USERNAMES" -l 5)
			[[ -z $susername ]] && { echo "No username selected." ; exit 0 ; }
			pass show -c "$susername"
			;;
		otp)
			sotp=$(otpfiles | dmenu -p "OTP" -l 5)
			[[ -z $sotp ]] && { echo "No OTP selected." ; exit 0 ; }
			pass otp show -c "$sotp"
			;;
		url)
			surl=$(urlfiles | dmenu -l 5)
			[[ -z $surl ]] && { echo "No URL selected." ; exit 0 ; }
			pass show -c "$surl"
			;;
		insert)
			name=$(passfiles | dmenu -p "insert new pass" -l 5)
			term-window exe "pass-insert '$name'"
 			;;
		generate)
			newpass=$(passfiles | dmenu -p "GENERATE NEW PASS" -l 5)
			[[ -n "$newpass" ]] && pass generate "$newpass"
			;;
		\|) exit 0 ;;
		*) opts ;;
	esac
}

if [[ -n "$1" ]]; then
	opts "$@"
else
	prompt="[PASS]"
	opts=("pass" "otp" "username" "url" "|" "insert" "generate" )
	sel=$(printf "%s\n" "${opts[@]}" | dmenu -p "$prompt")
	[[ -n $sel ]] && opts "$sel" || exit 0
fi
