#!/usr/bin/env dash

colorschemes="suckless-dark suckless-light suckless-blue"

selected_scheme=$1
if [ -z "$1" ]; then
	selected_scheme=$(printf "%s\n" $colorschemes | dmenu)
	if [ -z $selected_scheme ]; then
		exit 0
	fi
fi

echo "SETTING COLORSCHEME :: $selected_scheme"

# ----------------------
# VIM COLORSCHEME UPDATE
# ----------------------
sed -i '' -E "s/colorscheme.+/colorscheme $selected_scheme/g" ~/dotfiles/vim/.vim/vimrc

# ------------------------
# EMACS COLORSCHEME UPDATE
# ------------------------
sed -i '' -E "s/\(load-theme.+)/\(load-theme '$selected_scheme t)/g" ~/dotfiles/emacs/.emacs.d/config.el

# -----------------------
# TMUX COLORSCHEME UPDATE
# -----------------------
tmux_colors_path="~/.config/tmux/colors/"
sed -i '' -E "s|source $tmux_colors_path.+|source $tmux_colors_path$selected_scheme.conf|g" ~/dotfiles/tmux/.config/tmux/tmux.conf

# -------------------------
# GHOSTTY COLORSCHME UPDATE
# -------------------------
sed -i '' -E "s/theme.+/theme = \"$selected_scheme\"/g" ~/dotfiles/ghostty/.config/ghostty/config

# ----------------------------
# ALACRITTY COLORSCHEME UPDATE
# ----------------------------
alacritty_colors_path="~/.config/alacritty/colors/"
sed -i '' -E "s|$alacritty_colors_path.+|$alacritty_colors_path$selected_scheme.toml\",|g" ~/dotfiles/alacritty/.config/alacritty/alacritty.toml
