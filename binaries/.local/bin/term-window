#!/usr/bin/env bash

floating_window()
{
	title="f:$1"
	cmd="$2"
	if [ -z "$title" ] || [ -z "$cmd" ]; then
		echo "ERROR: \$1:title and \$2:cmd required"
		exit 1
	fi

	posx=0
	posy=0

       	window_rows="${4:-40}" # $4 arg
	window_cols="${3:-80}" # $3 arg

	alacritty --title="$title" \
		-o window.position.x=$posx \
	 	   window.position.y=$posy \
		   window.dimensions.columns=$window_cols \
		   window.dimensions.lines=$window_rows \
		-e bash -c "$cmd"

	# xq ; st -t="$title" \
	#    -e bash -c "$cmd" && yabai -m window --focus recent 

	# open -n /Applications/Ghostty.app/ \
	# 	--args --title="$title" \
	# 	       --window-width=$window_cols \
	#                --window-height=$window_rows \
	# 	       --window-position-x=$posx \
	# 	       --window-position-y=$posy \
	# 	-e bash -c "$cmd"
}

window_types=(
	ch # clipboard history
	launcher
	yabai-fzy-window
	exe # execute custom $2 as cmd
	cmd
	pass
	bweb # browse web
	www
	dictionary
	bookmarks
	snippets
	radio
	webcam
)

chosen_window=$1
if [ -z $chosen_window ]; then
	chosen_window=$(printf "%s\n" "${window_types[@]}" | fzy)
fi

case "$chosen_window" in
	ch) floating_window "ch" "~/.local/bin/ch $2" 120 40 ;;
	launcher) floating_window "launcher" "~/.local/bin/app-open $2" ;;
	yabai-fzy-window) floating_window "yabai-fzy-window" "~/.local/bin/yabai-fzy-window $2" ;;
	exe) floating_window "exe" "$2" ;;
	cmd) floating_window "cmd" "~/.local/bin/cmd $2" 100 42 ;;
	pass) floating_window "pass" "~/.local/bin/pass-copy $2" 60 30 ;;
	bweb) floating_window "bweb" "tmux a -t bweb || tmux new -s bweb" 100 40 ;;
	www) floating_window "www" "~/.local/bin/www $2" 80 5 ;;
	dictionary) floating_window "dictionary" "~/.local/bin/dictionary $2" 80 40 ;;
	bookmarks) floating_window "bookmarks" "~/.local/bin/bookmarks $2" 150 40 ;;
	snippets) floating_window "snippets" "~/.local/bin/snippet-copy $2" ;;
	radio) floating_window "radio" "~/.local/bin/radio $2" ;;
	webcam) floating_window "webcam" "~/.local/bin/webcam $2" 60 30 ;;
	*) exit 0 ;;
esac	
