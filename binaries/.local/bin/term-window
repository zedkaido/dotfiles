#!/usr/bin/env bash

floating_window()
{
	title="f:$1($RANDOM)"
	cmd="$2"
	if [ -z "$title" ] || [ -z "$cmd" ]; then
		echo "ERROR: \$1:title and \$2:cmd required"
		exit 1
	fi

	cols=0
	rows=0

	# <r>:<c>:<x>:<y>:<w>:<h>
	grid="${3:-4:4:1:1:2:2}" 
	echo $grid

	alacritty --title="$title" \
		-o window.dimensions.columns=$cols \
		   window.dimensions.lines=$rows \
		-e bash -c "$cmd" &

	while :; do
		winID=$(yabai -m query --windows --space \
			| jq -r --arg t "$title" '.[] | select(.title == $t) | .id')
		[ -n "$winID" ] && break
		sleep 0.1
	done
	
	yabai -m window "$winID" --grid $grid
	
	# xq ; st -t="$title" \
	#    -e bash -c "$cmd" && yabai -m window --focus recent 

	# open -n /Applications/Ghostty.app/ \
	# 	--args --title="$title" \
	# 	       --window-width=$cols \
	#          --window-height=$rows \
	# 	-e bash -c "$cmd"
}

window_types=(
	ch # clipboard history
	launcher
	yabai-fzy-window
	exe # execute custom $2 as cmd
	cmd
	pass
	bweb # browse web
	www
	dictionary
	bookmarks
	snippets
	radio
	webcam
)

chosen_window=$1
if [ -z $chosen_window ]; then
	chosen_window=$(printf "%s\n" "${window_types[@]}" | fzy)
fi

case "$chosen_window" in
	ch) floating_window "ch" "~/.local/bin/ch $2" 120 40 ;;
	launcher) floating_window "launcher" "~/.local/bin/app-open $2" ;;
	yabai-fzy-window) floating_window "yabai-fzy-window" "~/.local/bin/yabai-fzy-window $2" ;;
	exe) floating_window "exe" "$2" ;;
	cmd) floating_window "cmd" "~/.local/bin/cmd $2" ;;
	pass) floating_window "pass" "~/.local/bin/pass-copy $2" 10:1:0:9:2:1 ;;
	bweb) floating_window "bweb" "tmux a -t bweb || tmux new -s bweb" ;;
	www) floating_window "www" "~/.local/bin/www $2" 80 5 ;;
	dictionary) floating_window "dictionary" "~/.local/bin/dictionary $2" ;;
	bookmarks) floating_window "bookmarks" "~/.local/bin/bookmarks $2" ;;
	snippets) floating_window "snippets" "~/.local/bin/snippet-copy $2" ;;
	radio) floating_window "radio" "~/.local/bin/radio $2" 8:1:0:0:2:1 ;;
	webcam) floating_window "webcam" "~/.local/bin/webcam $2" 15:42:0:0:2:1 ;;
	*) exit 0 ;;
esac	
