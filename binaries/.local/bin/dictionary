#!/usr/bin/env bash

command -v dmenu >/dev/null 2>&1 || { echo "ERROR: dmenu bin is required." >&2 ; exit 1 ; }
command -v term-window >/dev/null 2>&1 || { echo "ERROR: term-window bin is required." >&2 ; }

open_sdcv() { sdcv ; }

lookup_offline_def() {
	word="$1"
	if [ -z "$word" ]; then
		word=$(echo "" | dmenu -p "[sdcv] Definition for: ")
	fi
	if [[ -n "$word" ]]; then
	   	term-window exe "sdcv -n $word | vim - -R"
	else
		term-window exe "sdcv"
	fi
}

lookup_online_def() {
	word="$1"
	if [ -z "$word" ]; then
		word=$(echo "" | dmenu -p "[dict] Definition for: ")
	fi
	[[ -n "$word" ]] && term-window exe "dict $word | vim - -R" || exit 1
}

lookup_synonym() {
	word="$1"
	if [ -z "$word" ]; then
		word=$(echo "" | dmenu -p "[synonyms] Synonyms for: ")
	fi

	command -v synonyms >/dev/null 2>&1 || {
		echo "ERROR: synonyms bin is required." >&2
		exit 1
	}
	[[ -n "$word" ]] && term-window exe "synonyms $word ; read" || exit 1

	# WEB SEARCH ALTERNATIVE:
	# www "$word !synonyms" &
}

opts() {
	case "$1" in
		def*|offline) lookup_offline_def "$2" ;;
		sdcv) lookup_offline_def "$2" ;;
		dict*|online) lookup_online_def "$2" ;;
		syn*) lookup_synonym "$2" ;;
	esac
}

if [[ -n "$1" ]]; then
	opts "$@"
else
	opts=("definition" "synonyms" "sdcv" "dict")
	sel=$(printf "%s\n" "${opts[@]}" | dmenu)
	opts "$sel"
fi

