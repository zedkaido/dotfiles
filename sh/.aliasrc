# vim: filetype=sh

# alias cht='cht.sh'

alias svim='sudo vim'
alias svifm='sudo vifm'
alias manv="MANPAGER='vim -M +MANPAGER -' man"

alias km='vim +KM'
alias journal='vim +JR'
alias tsks='vim +TSKS'
alias note='vim +KMNote'
alias osx='vim +OSX'
alias webm='vim +WEBM'

alias e='emacs'
alias ed='emacs --daemon'
alias ec='emacsclient -t'
alias ek="emacsclient -e '(kill-emacs)'"

alias timer='countdown'
alias color='pastel'

alias fzf='fzf --no-color'
alias htop='htop --no-color'

alias q='exit'
alias cs='clear;ls'

alias r='fc -s'
alias hr='history -r ~/.bash_history' # (h)istory -(r)ead
alias hs='history | grep $1' # (h)istory -(s)earch
alias ha='fc -ln -1 >> ~/.bash_history' # (h)istory (a)rchive
alias he='vim ~/.bash_history' # (h)istory (e)dit

alias la='ls -AF' # List all files
alias ldir='ls -d */' # List only directories
alias l.='ls -A | egrep "^\\." ' # List only dotfiles (hidden files)
alias l1='ls -1AF' # List files (one line at a time)
alias ll='ls -lhAF' # List all file details
alias lg='ls -AF | egrep' # Grep through filenames (also see, hg)
alias lp='ls -d "$(pwd)"/*' # List full paths
alias lpg='ls -d "$(pwd)"/* | grep' # Grep through filenames but list full path
alias lt='ls -Alt' # Sort by time
alias ltr='ls -Altr' # Sort by time (reverse)
alias lss='ls -AFlS' # Sort by size
alias lsr='ls -AFlSr' # Sort by size (reverse)

alias ff='find . -type f -iname' # search file
alias fd='find . -type d -iname' # search directory

alias cd..='cd ..'
alias ..='cd ..'
alias ..2='cd ../../'
alias ..3='cd ../../../'
alias ..4='cd ../../../../'
alias ..5='cd ../../../../..'

alias path='echo -e ${PATH//:/\\n}'
alias myip='curl http://ipecho.net/plain; echo'

alias psgrep='ps aux | grep'
alias now='date +"%T"'
alias nowtime=now
alias nowdate='date +"%d-%m-%Y"'
alias nocomment='grep -Ev '\''^(#|$)'\'''

alias usage='du -ch 2> /dev/null | tail -1'
alias totalusage='df -hl --total | tail -1'
alias partusage='df -hlT --exclude-type=tmpfs --exclude-type=devtmpfs'
alias most='du -hsx * | sort -rh | head -10'

alias archive='tar --create --gzip --verbose --file'

# mpv video/audio limit for ytdl
alias mpv-yt-best='mpv --ytdl-format="bestvideo+bestaudio/best"'
alias mpv-yt-4k='mpv --ytdl-format="bestvideo[height<=2160][vcodec*=hvc1]/bestvideo[height<=2160][vcodec*=avc1]+bestaudio/best"'
alias mpv-yt-hd='mpv --ytdl-format="bestvideo[height<=1080][vcodec*=hvc1]/bestvideo[height<=1080][vcodec*=avc1]+bestaudio/best"'

# ---------------
# OSX (ONLY) CMDS
# TODO: add linux support (replace with binaries) 
# -----------------------------------------------
alias empty-trash="osascript -e 'tell application \"Finder\" to empty trash'"
alias preview="qlmanage -p"

alias os-sleep='prompt "Are you sure (sleep)?" "pmset sleepnow"' 
alias os-display-sleep='prompt "Are you sure (sleep displays)" "pmset displaysleepnow"'
alias os-shut-down='prompt "Are you sure (shutdown)?" "sudo shutdown -h now"'
